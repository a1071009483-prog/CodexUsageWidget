<Application
    x:Class="CodexUsageWidget.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:CodexUsageWidget.App.Converters"
    xmlns:vm="clr-namespace:CodexUsageWidget.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <converters:ColorStateToBrushConverter x:Key="ColorStateBrushConverter" />
            <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:QuotaCardViewModel}">
                <Border
                    Padding="12,10"
                    Background="#27272F"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="12"
                            Foreground="#AAAAAA"
                            Text="{Binding BucketLabel}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="{Binding StatusText}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,6,0,4"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding RemainingPercentText}" />

                        <ProgressBar
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Height="6"
                            Margin="0,0,0,4"
                            Background="#3A3A44"
                            BorderThickness="0"
                            Foreground="{Binding ColorState, Converter={StaticResource ColorStateBrushConverter}}"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding ProgressValue, Mode=OneWay}" />

                        <Grid
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,14,0,0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="11"
                                Foreground="#888888"
                                Text="{Binding CountdownText, StringFormat='重置 {0}'}"
                                Visibility="{Binding CountdownText, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="#888888"
                                Text="{Binding LastSyncTimeText, StringFormat='同步 {0}'}" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

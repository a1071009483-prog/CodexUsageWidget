<Window
    x:Class="CodexUsageWidget.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CodexUsageWidget.App.ViewModels"
    Title="Codex Usage Widget"
    Width="320"
    Height="Auto"
    MinWidth="260"
    MinHeight="140"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">
    <Border
        Background="#1E1E24"
        BorderBrush="#3A3A44"
        BorderThickness="1"
        CornerRadius="16"
        MouseLeftButtonDown="OnBorderMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="16"
                Direction="270"
                Opacity="0.35"
                ShadowDepth="4"
                Color="Black" />
        </Border.Effect>
        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#EAEAEA"
                    Text="Codex 用量" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Width="22"
                        Height="22"
                        Margin="0,0,6,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnHideClick"
                        Content="_"
                        Foreground="#AAAAAA" />
                    <Button
                        Width="22"
                        Height="22"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCloseClick"
                        Content="×"
                        FontSize="14"
                        Foreground="#AAAAAA" />
                </StackPanel>
            </Grid>

            <!-- Connection state -->
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,12"
                FontSize="11"
                Foreground="#888888"
                Text="{Binding ConnectionStateText}" />

            <!-- Cards -->
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <ContentControl Margin="0,0,0,10" Content="{Binding FiveHour}" />
                <ContentControl Content="{Binding Weekly}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
